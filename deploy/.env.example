# Copy to deploy/.env on homeserver (never commit .env), then: chmod 600 deploy/.env
# Full walkthrough: docs/DEPLOY.md
#
# Tailscale auth key: admin console → Settings → Keys → Generate auth key
#   Reusable: OFF · Ephemeral: off · Pre-approved: on · Tags: tag:notes
# Used only for the FIRST login; afterwards the node identity lives in the tailscale-state volume.
# DELETE this line after the first successful login (DEPLOY.md). Tagged nodes have key expiry disabled by default.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Host names the app answers to (Host allowlist, DESIGN §5.13). Your tailnet's MagicDNS name:
NOTES_ALLOWED_HOSTS=notes.<tailnet>.ts.net

# Tailscale logins allowed to use the app (identity allowlist). Comma-separated.
# Use the login exactly as the admin console's Users page shows it (GitHub sign-ins look like name@github).
NOTES_IDENTITY_ALLOWED_LOGINS=you@example.com

# Optional: Watchtower update reports. Leave empty for none; ntfy is recommended (DEPLOY.md), for example
#   WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.sh/notes-<32 random characters>
# or a self-hosted ntfy server: ntfy://ntfy.example.com/<topic>
WATCHTOWER_NOTIFICATION_URL=

# Time zone (IANA name) for logs and git commit timestamps (daily notes use the browser's time zone).
TZ=America/New_York

# ---- Backups (optional, strongly recommended; DEPLOY.md "Backups"). Nothing runs until COMPOSE_PROFILES is set:
#   backup            restic sidecar + backup-scheduler (a nightly run at NOTES_BACKUP_TIME)
#   backup-host-cron  restic sidecar only; host cron runs deploy/backup/nightly.sh instead (DEPLOY.md)
# The repository password and the off-site keys are files in deploy/secrets/, never variables here.
COMPOSE_PROFILES=
# The local repository: a directory on a SECOND disk (USB or internal) mounted on homeserver. It must exist.
NOTES_BACKUP_LOCAL_REPO=/mnt/backup/notes-restic
# Off-site repository through the S3 API. Empty = local only. Backblaze B2 (its S3 endpoint) or AWS S3:
#   s3:https://s3.us-west-004.backblazeb2.com/<bucket>/notes
#   s3:https://s3.eu-central-1.amazonaws.com/<bucket>/notes
NOTES_BACKUP_OFFSITE_REPO=
# Daily run, HH:MM in TZ. NotesApp is stopped for the local snapshot, usually for well under a minute.
NOTES_BACKUP_TIME=04:00
# Failure alerts and a weekly "backups OK": an ntfy topic URL such as https://ntfy.sh/notes-<hex> (Watchtower's topic is fine).
NOTES_BACKUP_NTFY_URL=
# Optional dead man's switch, pinged after every good run; it alerts you when the pings stop. E.g. https://hc-ping.com/<uuid>
NOTES_BACKUP_HEARTBEAT_URL=

# ---- Git history (DEPLOY.md "Large files"). Files larger than this stay in the vault, and in backups, but out of
# git history, so the repository stays small. 0 = version every file. GitHub refuses files over 100 MB, so keep it
# below that if you use the mirror. At least 5MB (the largest note NotesApp saves), or the app refuses to start.
NOTES_GIT_LARGE_FILE_THRESHOLD=25MB

# ---- Mirror of the vault's history to a private GitHub repository (optional; DEPLOY.md "Mirror to GitHub").
# Your notes then also live on GitHub. Empty = no mirror.
#   NOTES_MIRROR_URL=https://github.com/<you>/<private repo>.git
NOTES_MIRROR_URL=
# The file holding the access token (a fine-grained token: Contents read and write, on that repository only),
# relative to deploy/. Empty = the empty placeholder deploy/mirror/no-token. Never put the token itself here.
#   NOTES_MIRROR_TOKEN_SECRET=./secrets/mirror-token
NOTES_MIRROR_TOKEN_SECRET=

# ---- Ask your vault and summaries, powered by Claude (optional; DEPLOY.md "Ask your vault"). By default it runs the
# image's Claude Code with your subscription, using a token in /srv/notes/data/secrets/claude-token (nothing to set
# here). For the Anthropic API provider instead (billed per token), off until you switch it
# on in Settings; when used, questions and the notes they need are sent to Anthropic's API. The file holding the
# Anthropic API key, relative to deploy/. Empty = the empty placeholder deploy/ai/no-key. Never put the key itself here.
#   NOTES_AI_KEY_SECRET=./secrets/anthropic-key
NOTES_AI_KEY_SECRET=

# ---- Backup status on the status page (ROADMAP item 38). backup-scheduler's state volume is mounted read-only into
# the app by default. With host cron instead, point this at the directory your cron job writes status.json to,
# created by you BEFORE docker compose up -d mounts it (Docker would create it as root; DEPLOY.md "Host cron"):
#   NOTES_BACKUP_STATE=/home/<you>/.local/state/notesapp-backup
NOTES_BACKUP_STATE=

# ---- Voice-note transcription (optional; DEPLOY.md "Voice notes"). Recording works without it; this adds the text.
# Turn it on with the bundled whisper service: add transcription to COMPOSE_PROFILES above (e.g.
# COMPOSE_PROFILES=backup,transcription) and set the URL below. Empty URL = off.
#   NOTES_TRANSCRIPTION_URL=http://whisper:9000
NOTES_TRANSCRIPTION_URL=
# whisper-asr (the bundled service) or openai (any /v1/audio/transcriptions server: whisper.cpp, speaches, LocalAI).
NOTES_TRANSCRIPTION_API=whisper-asr
# The spoken language, e.g. en or de. Empty = detected for each recording.
NOTES_TRANSCRIPTION_LANGUAGE=
# The bundled service's model: base (fast), small (default), medium (better, needs a strong CPU and ~2 GB of RAM).
NOTES_WHISPER_MODEL=small
# Only for NOTES_TRANSCRIPTION_API=openai: the model name the server expects (OpenAI: whisper-1), and the file holding
# its API key, if it needs one: under /data/secrets/ (outside the vault, never committed), readable by uid 1000.
NOTES_TRANSCRIPTION_MODEL=whisper-1
NOTES_TRANSCRIPTION_API_KEY_FILE=
