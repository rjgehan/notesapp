# Copy to deploy/.env on homeserver (never commit .env), then: chmod 600 deploy/.env
# Full walkthrough: docs/DEPLOY.md
#
# Tailscale auth key: admin console → Settings → Keys → Generate auth key
#   Reusable: OFF · Ephemeral: off · Pre-approved: on · Tags: tag:notes
# Used only for the FIRST login; afterwards the node identity lives in the tailscale-state volume.
# DELETE this line after the first successful login (DEPLOY.md). Tagged nodes have key expiry disabled by default.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Host names the app answers to (Host allowlist, DESIGN §5.13). Your tailnet's MagicDNS name:
NOTES_ALLOWED_HOSTS=notes.<tailnet>.ts.net

# Tailscale logins allowed to use the app (identity allowlist). Comma-separated.
# Use the login exactly as the admin console's Users page shows it (GitHub sign-ins look like name@github).
NOTES_IDENTITY_ALLOWED_LOGINS=you@example.com

# Optional: Watchtower update reports. Leave empty for none; ntfy is recommended (DEPLOY.md), for example
#   WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.sh/notes-<32 random characters>
# or a self-hosted ntfy server: ntfy://ntfy.example.com/<topic>
WATCHTOWER_NOTIFICATION_URL=

# Time zone (IANA name) for logs and git commit timestamps (daily notes use the browser's time zone).
TZ=America/New_York

# ---- Backups (optional, strongly recommended; DEPLOY.md "Backups"). Nothing runs until COMPOSE_PROFILES is set:
#   backup            restic sidecar + backup-scheduler (a nightly run at NOTES_BACKUP_TIME)
#   backup-host-cron  restic sidecar only; host cron runs deploy/backup/nightly.sh instead (DEPLOY.md)
# The repository password and the off-site keys are files in deploy/secrets/, never variables here.
COMPOSE_PROFILES=
# The local repository: a directory on a SECOND disk (USB or internal) mounted on homeserver. It must exist.
NOTES_BACKUP_LOCAL_REPO=/mnt/backup/notes-restic
# Off-site repository through the S3 API. Empty = local only. Backblaze B2 (its S3 endpoint) or AWS S3:
#   s3:https://s3.us-west-004.backblazeb2.com/<bucket>/notes
#   s3:https://s3.eu-central-1.amazonaws.com/<bucket>/notes
NOTES_BACKUP_OFFSITE_REPO=
# Daily run, HH:MM in TZ. NotesApp is stopped for the local snapshot, usually for well under a minute.
NOTES_BACKUP_TIME=04:00
# Failure alerts and a weekly "backups OK": an ntfy topic URL such as https://ntfy.sh/notes-<hex> (Watchtower's topic is fine).
NOTES_BACKUP_NTFY_URL=
# Optional dead man's switch, pinged after every good run; it alerts you when the pings stop. E.g. https://hc-ping.com/<uuid>
NOTES_BACKUP_HEARTBEAT_URL=
